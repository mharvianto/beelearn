<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ClientApp/**" />
    <Content Remove="ClientApp/**" />
    <None Remove="ClientApp/**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets/fonts/*.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Build the Vue SPA into wwwroot for publish (skip with -p:BuildClient=false).
    Runs before Build so the freshly written wwwroot/** is picked up by the
    static-web-assets glob in the SAME publish, then a post-publish copy
    guarantees it lands in the output even on the very first clean run.
  -->
  <Target Name="BuildClientApp" BeforeTargets="BeforeBuild;BeforeRebuild" Condition="'$(BuildClient)' != 'false'">
    <Exec Command="npm ci" WorkingDirectory="ClientApp" />
    <Exec Command="npm run build" WorkingDirectory="ClientApp" />
  </Target>

  <Target Name="CopyClientToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_ClientPublishFiles Include="wwwroot/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ClientPublishFiles)" DestinationFiles="@(_ClientPublishFiles->'$(PublishDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.11" />
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.1" />
  </ItemGroup>

</Project>
