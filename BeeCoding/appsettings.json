{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=beecoding.db"
  },
  "Judge": {
    "WorkRoot": "/tmp/beecoding-judge",
    "MaxConcurrent": 2,
    "CompileTimeoutMs": 10000,
    "QueueCapacity": 200,
    "HardWallBufferMs": 800,
    "RunTimeLimitMs": 1000,
    "RunMemoryLimitKb": 32768,
    "RateLimitMs": 1500,
    "RequireSandbox": false
  },
  "Lsp": {
    "Enabled": false,
    "ClangdPath": "clangd",
    "MaxConcurrent": 4,
    "IdleTimeoutSeconds": 300,
    "MemoryLimitMb": 0
  },
  "Admin": {
    "Token": ""
  },
  "Auth": {
    "TeacherSignupCode": ""
  },
  "Security": {
    "_comment": "Set ContentSecurityPolicy to a custom string to override the built-in default, or to \"off\" to send no CSP header."
  }
}
